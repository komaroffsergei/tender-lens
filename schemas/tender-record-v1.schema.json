{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/tender-record-v1.schema.json",
  "$defs": {
    "AttachmentRecordV1": {
      "additionalProperties": false,
      "properties": {
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "filename": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        }
      },
      "required": [
        "filename",
        "source_url"
      ],
      "title": "AttachmentRecordV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "enum": [
        "ted",
        "contracts_finder"
      ],
      "title": "Source",
      "type": "string"
    },
    "external_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "External Id",
      "type": "string"
    },
    "title": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "buyer_name": {
      "anyOf": [
        {
          "maxLength": 5000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Buyer Name"
    },
    "amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amount"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "source_url": {
      "format": "uri",
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "attachments": {
      "items": {
        "$ref": "#/$defs/AttachmentRecordV1"
      },
      "title": "Attachments",
      "type": "array"
    },
    "raw_payload": {
      "additionalProperties": true,
      "title": "Raw Payload",
      "type": "object"
    }
  },
  "required": [
    "source",
    "external_id",
    "title",
    "source_url",
    "raw_payload"
  ],
  "title": "TenderRecordV1",
  "type": "object"
}
