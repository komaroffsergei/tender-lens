{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/tender-record-v1.schema.json",
  "title": "TenderRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "external_id",
    "title",
    "source_url",
    "attachments",
    "raw_payload"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "ted",
        "contracts_finder"
      ]
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "buyer_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "source_url"
        ],
        "properties": {
          "external_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "content_type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          }
        }
      }
    },
    "raw_payload": {
      "type": "object"
    }
  }
}
